{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "tag": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name", "automountToken", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "automountToken": {"type": "boolean"},
        "annotations": {"type": "object"}
      }
    },
    "rbac": {
      "type": "object",
      "required": ["create", "targetNamespaces"],
      "properties": {
        "create": {"type": "boolean"},
        "targetNamespaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
